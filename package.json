{
  "name": "webos-iptv-player",
  "version": "1.0.0",
  "description": "IPTV player application supporting M3U, M3U8, and Xtream Codes API optimized for LG webOS TV",
  "main": "index.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "pack": "ares-package build -o ./dist_pkg"
  },
  "dependencies": {
    "@enact/core": "^5.6.0",
    "@enact/sandstone": "^2.9.13",
    "@enact/spotlight": "^5.6.0",
    "dexie": "^3.2.4",
    "hls.js": "^1.5.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "react-scripts": "^5.0.1"
  },
  "browserslist": {
    "production": [
      "chrome >= 68"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "keywords": [
